# SLBCK - SaguaroLocalBackup configuration
# Location on server: /etc/slbck/slbck.conf (chmod 600)
# Easiest way to configure: run 'slbck setup'

# Database engine: auto | mysql | mariadb | postgresql
# (mariadb uses the same toolchain as mysql - both are fully supported)
DB_ENGINE="auto"

# Where per-database gzipped dumps are stored (one folder per day)
BACKUP_DIR="/var/backups/slbck"

# Keep last N daily backup folders locally
RETENTION_DAYS="3"

# Hour of the daily cron run (1-6 = 01:00-06:00 server local time)
CRON_HOUR="3"

# Abort backup if free disk space is below this (or below 2x last backup size)
MIN_FREE_MB="500"

# --- GPG encryption ---------------------------------------------------------
# yes = dumps are AES256-encrypted at rest (.sql.gz.gpg), locally and remote.
# Passphrase: min 12 characters. WITHOUT IT THERE IS NO RESTORE - store it in
# your password manager too, not only on this server!
ENCRYPT_ENABLED="no"
ENCRYPT_PASSPHRASE=''

# --- Weekly restore test ----------------------------------------------------
# SLBCK restores one database into a temporary DB (slbck_verify), counts the
# tables and drops it - proof that backups are actually restorable. Result is
# part of the backup mail; run manually anytime with 'slbck verify'.
VERIFY_ENABLED="yes"
VERIFY_DAY="7"          # 1=Mon .. 7=Sun

# --- Folder backup ----------------------------------------------------------
# ARCHIVE: small folders (e.g. /etc) -> daily tar.gz stored WITH the DB dumps
# (same retention, mirror, encryption, verify). Space separated. Keep small!
ARCHIVE_DIRS="/etc"
# MIRROR: big folders (e.g. /var/www) rsynced DIRECTLY to the remote server,
# never stored locally. List them in /etc/slbck/folders.conf (one per line),
# excludes in /etc/slbck/folder-excludes.conf. Requires REMOTE_METHOD=rsync.
# History/versions come from Storage Box snapshots - enable them!
FOLDERS_ENABLED="no"
# Warn in the mail when a mirrored folder exceeds this size
FOLDERS_MAX_GB="50"
# no  = SAFE sync (default): remote only gets adds/updates, never deletions -
#       a file deleted locally stays on the remote.
# yes = true mirror: local deletions propagate to the remote (Storage Box
#       snapshots still keep history).
FOLDERS_DELETE="no"

# --- E-mail notifications ---------------------------------------------------
# If the server has no mail transport, 'slbck setup' offers to install and
# configure msmtp (lightweight SMTP relay) automatically.
MAIL_ENABLED="no"
# One or more recipients, comma separated: "a@x.com, b@y.com"
MAIL_TO=""
# Empty = slbck@<hostname>
MAIL_FROM=""
# always = mail on every backup, error = mail only on failure
MAIL_ON="always"

# --- Off-server copy -------------------------------------------------------
# Hetzner Storage Box example (enable "SSH support" in Robot panel first):
#   REMOTE_METHOD="rsync"  REMOTE_HOST="uXXXXX.your-storagebox.de"
#   REMOTE_PORT="23"       REMOTE_USER="uXXXXX" (or a sub-account per server)
#   REMOTE_PATH="/home/backup"  REMOTE_SUBDIR="auto"
# Also enable Storage Box snapshots - a compromised server then cannot
# destroy its own remote backups.
REMOTE_ENABLED="no"
# rsync = mirrors the whole local backup dir (remote keeps same retention)
# sftp  = uploads today's folder only
REMOTE_METHOD="rsync"
REMOTE_HOST=""
REMOTE_PORT="22"
REMOTE_USER=""
REMOTE_PATH=""
# Subfolder on the remote so multiple servers can share one target:
# auto = short hostname of this server, empty = none, or a custom name.
# (Empty keeps the remote path identical to pre-1.3 versions.)
REMOTE_SUBDIR=""
# Optional SSH private key; empty = root's default key. Key auth must already
# work non-interactively (ssh-copy-id) - SLBCK never stores SSH passwords.
SSH_KEY=""

# --- MySQL credentials -----------------------------------------------------
# Leave empty to use unix socket auth as root (default on Debian/Ubuntu/MariaDB).
# Otherwise create a dedicated backup user, e.g.:
#   CREATE USER 'slbck'@'localhost' IDENTIFIED BY '...';
#   GRANT SELECT, LOCK TABLES, SHOW VIEW, EVENT, TRIGGER, PROCESS ON *.* TO 'slbck'@'localhost';
MYSQL_USER=""
MYSQL_PASS=""
